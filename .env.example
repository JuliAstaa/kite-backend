APP_ENV=development
APP_HOST=127.0.0.1
PORT=8080
APP_TZ=Asia/Makassar

DB_URL=postgres://finance:finance@localhost:5432/finance_tracker?sslmode=disable
DB_MAX_CONNS=10
DB_IDLE_CONNS=5

# Dipakai test repository. Boleh dikosongkan, test yang butuh database
# otomatis di-skip.
DB_URL_TEST=postgres://finance:finance@localhost:5432/finance_tracker_test?sslmode=disable

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Kosong berarti middleware token jadi no-op. Isi kalau API mau diakses dari
# perangkat lain di jaringan lokal, lalu kirim header X-API-Token.
# Di server WAJIB diisi: openssl rand -hex 32
API_TOKEN=

# ---- Docker Compose ----
# Dibaca docker compose untuk mengisi ${...} di docker-compose.yml.
# Password dipakai di dalam URL koneksi, jadi pakai karakter aman URL saja
# (openssl rand -hex 24). Kalau mengubahnya, samakan juga password di DB_URL
# dan DB_URL_TEST di atas.
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance_tracker

# Port di sisi host. Ganti kalau sudah dipakai service lain di server
# (misalnya DB_HOST_PORT=5433), lalu sesuaikan port di DB_URL.
DB_HOST_PORT=5432
API_HOST_PORT=8081

# 127.0.0.1 kalau API di belakang reverse proxy (nginx/caddy), 0.0.0.0 kalau
# mau diakses langsung dari luar.
API_BIND=127.0.0.1
