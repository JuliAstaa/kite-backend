APP_ENV=development
APP_HOST=127.0.0.1
PORT=8080
APP_TZ=Asia/Makassar

DB_URL=postgres://finance:finance@localhost:5432/finance_tracker?sslmode=disable
DB_MAX_CONNS=10
DB_IDLE_CONNS=5

# Dipakai test repository. Boleh dikosongkan, test yang butuh database
# otomatis di-skip.
DB_URL_TEST=postgres://finance:finance@localhost:5432/finance_tracker_test?sslmode=disable

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Kosong berarti middleware token jadi no-op. Isi kalau API mau diakses dari
# perangkat lain di jaringan lokal, lalu kirim header X-API-Token.
API_TOKEN=initokenapi
